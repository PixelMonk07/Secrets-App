<%- include('partials/header') %>

  <div class="page-shell">
    <header class="feed-header">
      <h1 class="feed-title">The wall of secrets</h1>
      <p class="feed-sub">Whispered by no one in particular.</p>
    </header>

    <% const secretsList = Array.isArray(secrets) ? secrets : (secrets ? [secrets] : []); %>

    <% if (secretsList.length === 0 || (secretsList.length === 1 && !secretsList[0])) { %>
      <div class="empty-state">
        <p>No secrets here yet. Be the first to whisper one.</p>
      </div>
    <% } else { %>
      <div class="feed-grid">
        <% secretsList.forEach(function(s, i) { %>
          <% const secretText = typeof s === 'string' ? s : (s && s.secret ? s.secret : ''); %>
          <% if (secretText) { %>
            <article class="secret-card" data-delay="<%= i * 0.05 %>">
              <span class="secret-badge">
                <i class="fas fa-user-secret"></i>
                <%= s.anonymous_name || "Anonymous" %>
              </span>
              <p class="secret-text">&ldquo;<%= secretText %>&rdquo;</p>
              <div class="secret-footer">
                <button
                  class="react-btn <%= s.liked_by_me ? 'liked' : '' %>"
                  type="button"
                  data-secret-id="<%= s.id %>"
                  aria-label="React to this secret"
                >
                  <i class="<%= s.liked_by_me ? 'fas' : 'far' %> fa-heart"></i>
                  <span class="like-count"><%= s.like_count ?? 0 %></span>
                </button>
                <% if (s.user_id === currentUser.id) { %>

                  <div class="owner-actions">

                      <a
                          href="/edit/<%= s.id %>"
                          class="action-btn edit-btn"
                          title="Edit Secret">

                          <i class="fas fa-pen"></i>
                      </a>

                      <button
                          class="action-btn delete-btn"
                          data-secret-id="<%= s.id %>"
                          title="Delete Secret">

                          <i class="fas fa-trash-alt"></i>

                      </button>

                  </div>

                <% } %>
                <span class="secret-time">
                  <%= formatTime(s.created_at) %>
                </span>
              </div>
            </article>
          <% } %>
        <% }) %>
      </div>
    <% } %>

    <% const currentPage = Number(page) || 1; %>

    <div class="pagination">
      <% if (currentPage > 1) { %>
        <a href="/secrets?page=<%= currentPage - 1 %>" class="btn btn-ghost">Previous</a>
      <% } %>

      <span>Page <%= currentPage %></span>

      <a href="/secrets?page=<%= currentPage + 1 %>" class="btn btn-ghost">Next</a>
    </div>
  </div>

  <a href="/submit" class="fab" aria-label="Submit a new secret">
    <i class="fas fa-plus"></i>
  </a>

  <div class="toast" id="toast"></div>

    <div class="modal-overlay hidden" id="deleteModal">

    <div class="delete-modal">

        <button class="close-modal" id="closeModal">
            &times;
        </button>

        <h2>Wait...</h2>

        <p>
            Once whispered into the void,
            this secret can never be heard again.
            Are you absolutely sure?
        </p>

        <div class="modal-actions">

            <button id="cancelDelete"
                    class="cancel-btn">

                Keep it

            </button>

            <button id="confirmDelete"
                    class="confirm-btn">

                Delete Forever

            </button>

        </div>

    </div>

    </div>

  <script src="/js/secret.js"></script>
  <script src="/js/submit.js"></script>

<%- include('partials/footer') %>