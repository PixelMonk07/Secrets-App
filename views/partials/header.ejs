<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Secrets</title>
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.3/css/all.css" integrity="sha384-UHRtZLI+pbxtHCWp1t77Bi1L4ZtiqrqD80Kn4Z8NTSRyMA2Fd33n5dQ8lWUE00s/" crossorigin="anonymous">
  <link rel="stylesheet" href="css/styles.css">
</head>

<body>

  <nav class="navbar-glass">
    <div class="navbar-inner">
      <a href="<%= isAuthenticated ? '/secrets' : '/' %>" class="logo-mark">
        <i class="fas fa-lock lock-icon"></i>
        Secrets
      </a>
      <div class="nav-actions">

              <% if(isAuthenticated){ %>

                  <a href="/submit" class="nav-btn">
                      <i class="fas fa-plus"></i>
                      Whisper
                  </a>

                  <button
                    id="logoutBtn"
                    class="nav-btn logout-btn"
                    type="button">

                    <i class="fas fa-sign-out-alt"></i>
                    Logout

                  </button>

              <% } else { %>

                  <a href="/login" class="nav-btn">
                      Login
                  </a>

                  <a href="/register" class="nav-btn primary">
                      Register
                  </a>

              <% } %>

          </div>  
    </div>
  </nav>

  <div class="modal-overlay" id="logoutModal">

    <div class="delete-modal">

        <button
            class="close-modal"
            id="closeLogout">

            &times;

        </button>

        <h2>Leaving so soon?</h2>

        <p>

            The whispers will still be here when you return.

            Are you sure you want to disappear for now?

        </p>

        <div class="modal-actions">

            <button
                id="cancelLogout"
                class="cancel-btn">

                Stay

            </button>

            <button
                id="confirmLogout"
                class="confirm-btn">

                Logout

            </button>

        </div>

    </div>

</div>

<script src="/js/logout.js"></script>
</body>