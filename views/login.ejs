<%- include('partials/header') %>

  <div class="auth-wrap">
    <div class="auth-card">
      <p class="auth-eyebrow">Welcome back</p>
      <h1 class="auth-title">Continue whispering</h1>
      <p class="auth-subtitle">Your secrets are waiting. No one else can see this.</p>

      <!-- Makes POST request to /login route -->
      <form action="/login" method="POST">
        <div class="field">
          <label for="username">Email</label>
          <input type="email" id="username" name="username" placeholder="you@example.com" required>
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" required>
        </div>
        <button type="submit" class="btn btn-solid auth-submit">Log in</button>
      </form>

      <div class="auth-divider">or</div>

      <a class="btn btn-google" href="/auth/google" role="button">
        <i class="fab fa-google"></i>
        Continue with Google
      </a>

      <p class="auth-switch">New here? <a href="/register">Create an account</a></p>
    </div>
  </div>

<%- include('partials/footer') %>
