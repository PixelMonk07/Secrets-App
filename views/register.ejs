<%- include('partials/header') %>

  <div class="auth-wrap">
    <div class="auth-card">
      <p class="auth-eyebrow">Begin anonymously</p>
      <h1 class="auth-title">Create your account</h1>
      <p class="auth-subtitle">We only ever know your email. No one else ever will.</p>

      <!-- Makes POST request to /register route -->
      <form action="/register" method="POST">
        <div class="field">
          <label for="username">Email</label>
          <input type="email" id="username" name="username" placeholder="you@example.com" required>
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" required>
        </div>
        <button type="submit" class="btn btn-solid auth-submit">Create account</button>
      </form>

      <div class="auth-divider">or</div>

      <a class="btn btn-google" href="/auth/google" role="button">
        <i class="fab fa-google"></i>
        Continue with Google
      </a>

      <p class="auth-switch">Already have an account? <a href="/login">Log in</a></p>
    </div>
  </div>

<%- include('partials/footer') %>
